# =============================================================================
# Heavy Duty Rentals — environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put a
# secret behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
NODE_ENV=development
# Public origin. Used for canonical URLs, sitemap, hreflang, OAuth-style
# redirects and webhook callback URLs. Must be the real https origin in prod.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local dev points at the docker-compose Postgres on port 5433.
# Production MUST use sslmode=require.
DATABASE_URL=postgresql://hdr:hdr_dev_password@localhost:5433/hdr
# Max pool connections per app instance. On serverless, EACH concurrent
# invocation is an instance, so keep this at 1 there and let the pooler share.
DATABASE_POOL_MAX=10

# True when DATABASE_URL points at a TRANSACTION-mode pooler — PgBouncer, and
# therefore Neon's and Supabase's pooled endpoints. Such a pooler hands a
# different backend connection to each transaction, so a prepared statement is
# not there on the next one; this turns prepared statements off. Leave false on
# a direct connection, where the prepared path is faster and correct.
DATABASE_TRANSACTION_POOLER=false

# -----------------------------------------------------------------------------
# SECURITY / CRYPTO
# -----------------------------------------------------------------------------
# 32-byte base64 key used to encrypt MFA secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Secret used to derive the hash-chain seed for the audit log and to sign
# internal short-lived tokens. Generate the same way as ENCRYPTION_KEY.
APP_SECRET=

# Next.js encrypts the values captured in Server Action closures. Left unset,
# each build and each server instance generates its own key, so a request that
# lands on a different instance than the one that rendered the page fails to
# decrypt the action reference. REQUIRED once more than one instance runs;
# keep it identical across instances and stable across deploys.
# Generate: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Session lifetimes (seconds). Sliding, then a hard absolute ceiling.
SESSION_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=7776000

# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------
# mock   -> deterministic in-process provider. Development and tests only.
#           Creates no real charges and moves no money.
# moyasar-> reference real adapter (SAMA-licensed Saudi PSP; mada, Visa, MC,
#           Apple Pay, STC Pay). Requires a real merchant account.
PAYMENT_PROVIDER=mock

MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
# Shared secret configured in the Moyasar dashboard. Webhooks are rejected
# unless their signature verifies against this value.
MOYASAR_WEBHOOK_SECRET=

# Currency and tax. VAT is stored in parts-per-million: 15% = 150000.
CURRENCY=SAR
VAT_RATE_PPM=150000

# -----------------------------------------------------------------------------
# TAX INVOICING (ZATCA / Fatoora)
# -----------------------------------------------------------------------------
# local -> generates a structurally correct invoice, explicitly labelled
#          "not ZATCA-cleared". This is what ships by default.
# zatca -> Phase 2 clearance/reporting. Requires CSID onboarding and a tax
#          advisor's sign-off. NOT IMPLEMENTED. Selecting it now refuses to
#          start in production and refuses to issue an invoice anywhere else,
#          rather than quietly issuing uncleared ones while looking enabled.
TAX_INVOICE_PROVIDER=local
ZATCA_ENVIRONMENT=sandbox
ZATCA_CSID=
ZATCA_CSID_SECRET=
ZATCA_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# NOTHING IS SENT YET. The notification layer is not built — there is no mail
# transport behind either option, so nobody receives booking confirmations or
# password resets. Kept as a seam for when it lands; `smtp` refuses to start in
# production rather than looking configured while sending nothing.
EMAIL_PROVIDER=console
EMAIL_FROM="Heavy Duty Rentals <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
# As with email: no SMS transport exists behind either option. `http` refuses
# to start in production.
SMS_PROVIDER=console
SMS_SENDER_ID=
SMS_API_KEY=
SMS_API_SECRET=

# -----------------------------------------------------------------------------
# OBJECT STORAGE
# -----------------------------------------------------------------------------
# local -> ./storage on disk.
# s3    -> NOT IMPLEMENTED. There is no S3 driver; the keys below are a seam,
#          not working configuration. Selecting it refuses to start in
#          production rather than silently serving from disk.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Lifetime of generated download URLs, in seconds.
SIGNED_URL_TTL_SECONDS=300

# SEARCH_PROVIDER and ANALYTICS_PROVIDER used to be listed here. They were not
# in the environment schema and were read by no code, so they were not settings
# at all — a typo in either would have gone unnoticed because nothing parsed
# them. Search is Postgres full-text and analytics are recorded in our own
# database; both are decisions in the code, not switches. Removed rather than
# left here looking adjustable.

# -----------------------------------------------------------------------------
# MONITORING
# -----------------------------------------------------------------------------
# Boundary only — no vendor is wired. See docs/SECURITY.md §10.
MONITORING_DSN=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# memory   -> per-process. Correct for ONE long-lived instance and nothing else.
#             Across N instances the effective limit is N x the configured one.
#             On serverless it is not a limit at all: every cold start begins
#             with an empty map and concurrent invocations each keep their own.
# postgres -> one counter shared by every instance, in `rate_limit_bucket`.
#             Required for any deployment that is not a single process. Costs
#             one round trip on limited paths (login, checkout, booking lookup).
# redis    -> NOT IMPLEMENTED. Refused at startup rather than ignored.
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# -----------------------------------------------------------------------------
# BUSINESS CONFIGURATION
# -----------------------------------------------------------------------------
# Seed values for the settings table. After first seed these are edited in the
# admin console, not here. All values below are DEMO PLACEHOLDERS — replace
# them with the real company's details before any public deployment.
COMPANY_NAME_EN="Heavy Duty Rentals"
COMPANY_NAME_AR="هيفي ديوتي للتأجير"
COMPANY_VAT_NUMBER=300000000000003
COMPANY_CR_NUMBER=1010000000
COMPANY_PHONE=+966500000000
COMPANY_EMAIL=info@example.com
COMPANY_ADDRESS_EN="Demo address, Riyadh, Saudi Arabia"
COMPANY_ADDRESS_AR="عنوان تجريبي، الرياض، المملكة العربية السعودية"

# Above this capacity, instant booking is disabled and the class routes to the
# quote flow, because mobilisation cannot be priced honestly without a route
# survey. Business/operations decision — see docs/research.md §4.
INSTANT_BOOK_MAX_CAPACITY_KG=150000

# Minutes a checkout hold blocks a unit before it expires.
CHECKOUT_HOLD_MINUTES=20

# -----------------------------------------------------------------------------
# SEED / DEMO
# -----------------------------------------------------------------------------
# When true, seeded records are flagged as demo data and every page carries a
# banner saying no real payments are processed.
#
# It is also the ONE escape from the production boot check: DEMO_MODE=true is
# what permits PAYMENT_PROVIDER=mock to run under NODE_ENV=production, so a
# public demo can be deployed before there is a merchant account. The label and
# the permission are deliberately the same switch — you cannot have a
# payment-less deployment that does not say so.
#
# Setting it alongside a REAL provider is refused: the banner would be lying.
DEMO_MODE=true
SEED_ADMIN_EMAIL=admin@example.com
# Dev-only bootstrap password. The seed refuses to run with this value when
# NODE_ENV=production.
SEED_ADMIN_PASSWORD=ChangeMe_Dev_Only_123
