# ---------------------------------------------------------------------------
# Heavy Duty Rentals — environment
#
# The site is static and needs no secrets. Copy to .env.local only if you need
# to override the default below.
# ---------------------------------------------------------------------------

# The public origin of the site, without a trailing slash. Used for canonical
# URLs, hreflang, the sitemap, Open Graph tags and structured data.
#
# Read at BUILD time: changing it needs a rebuild and redeploy.
# Unset, it falls back to https://heavy-duty-rentals.vercel.app.
#
# Set it to the exact host visitors land on — if example.sa redirects to
# www.example.sa, use the www form.
# NEXT_PUBLIC_SITE_URL=https://www.example.sa
